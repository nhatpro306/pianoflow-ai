# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://pianoflow:pianoflow@localhost:5432/pianoflow

# ── Queue ───────────────────────────────────────────────────
QUEUE_BACKEND=redis            # redis | sqs
REDIS_URL=redis://localhost:6379/0
# Worker poll list. Production audio-worker runs with QUEUE_NAMES=q_audio only.
QUEUE_NAMES=q_default,q_audio

# ── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local          # local | supabase | s3
STORAGE_LOCAL_ROOT=./data/storage

# ── Supabase (production: database/auth/storage) ───────────
# Backend-only — never expose the service role key to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=          # required when AUTH_MODE=supabase

# AWS (Stage 3 / Phase 11)
AWS_REGION=us-east-1
SQS_QUEUE_DEFAULT_URL=
SQS_QUEUE_AUDIO_URL=
S3_BUCKET_SOURCES=pianoflow-sources
S3_BUCKET_ANALYSIS=pianoflow-analysis
S3_BUCKET_OUTPUTS=pianoflow-outputs

# ── Auth ────────────────────────────────────────────────────
AUTH_MODE=dev                  # dev | supabase

# ── CORS (production) ──────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://pianoflow.vercel.app

# ── Audio → MIDI Beta ───────────────────────────────────────
AUDIO_TRANSCRIPTION_ENABLED=true
MAX_AUDIO_BYTES=52428800       # 50 MB
MAX_AUDIO_SECONDS=180          # 3 minutes
TRANSCRIPTIONS_PER_DAY=5
AUDIO_QUEUE_NAME=q_audio
# Transcription engine. Set to basic_pitch on the dedicated audio worker
# (requires the pianoflow-music[basic-pitch] extra on Python ≤3.11).
TRANSCRIPTION_ENGINE=placeholder

# ── App ─────────────────────────────────────────────────────
ENV=dev                        # dev | staging | prod
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# ── Web (Next.js / Vercel) ──────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Modal (Demo — Vercel + Modal GPU pipeline) ──────────────
# Set after running: modal deploy infra/modal/transcribe_app.py
# Submit URL is the POST /submit endpoint; Result URL is the GET /result endpoint.
MODAL_SUBMIT_URL=
MODAL_RESULT_URL=
# Optional: shared token the route handler sends as Bearer for basic auth on the Modal endpoint.
# DEMO_PROXY_TOKEN=

# --- Demo: direct browser→Modal upload (bypasses Vercel's ~4.5MB body limit) ---
# These are exposed to the browser (NEXT_PUBLIC_*). When set, the web demo POSTs
# audio straight to the Modal endpoint instead of the /api/transcribe proxy, so
# full-length (3-4 min) songs work. Both URLs are the SAME base web URL — the
# client appends /submit and /result.
NEXT_PUBLIC_MODAL_SUBMIT_URL=https://<org>--pianoflow-transcribe-web.modal.run
NEXT_PUBLIC_MODAL_RESULT_URL=https://<org>--pianoflow-transcribe-web.modal.run
# Shared token the browser sends as X-Demo-Token; must match the DEMO_TOKEN in
# the Modal secret `pianoflow-demo`. Low-friction gate (ships in the bundle),
# not strong auth — it just stops random traffic burning GPU credits.
NEXT_PUBLIC_DEMO_TOKEN=
