# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://pianoflow:pianoflow@localhost:5432/pianoflow

# ── Queue ───────────────────────────────────────────────────
QUEUE_BACKEND=redis            # redis | sqs
REDIS_URL=redis://localhost:6379/0
# Worker poll list. Production audio-worker runs with QUEUE_NAMES=q_audio only.
QUEUE_NAMES=q_default,q_audio

# ── Storage ─────────────────────────────────────────────────
STORAGE_BACKEND=local          # local | supabase | s3
STORAGE_LOCAL_ROOT=./data/storage

# ── Supabase (production: database/auth/storage) ───────────
# Backend-only — never expose the service role key to the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# ── Auth ────────────────────────────────────────────────────
AUTH_MODE=dev                  # dev | supabase

# ── Audio → MIDI Beta ───────────────────────────────────────
AUDIO_TRANSCRIPTION_ENABLED=true
MAX_AUDIO_BYTES=52428800       # 50 MB
MAX_AUDIO_SECONDS=180          # 3 minutes
TRANSCRIPTIONS_PER_DAY=5
AUDIO_QUEUE_NAME=q_audio

# ── App ─────────────────────────────────────────────────────
ENV=dev                        # dev | staging | prod
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000

# ── Internal metrics (production only) ──────────────────────
# INTERNAL_METRICS_TOKEN=         # long random token; omit in dev (open access)

# ── Output lifecycle ─────────────────────────────────────────
OUTPUT_RETENTION_DAYS=30        # days before rendered outputs expire
CLEANUP_INTERVAL_SECONDS=900    # how often the worker runs the expiry sweep

# ── VPS / production Postgres (docker-compose.prod.yml) ─────
POSTGRES_USER=pianoflow
POSTGRES_PASSWORD=changeme      # change before deploying!
POSTGRES_DB=pianoflow

# ── Caddy (docker-compose.prod.yml) ──────────────────────────
DOMAIN=localhost                # your real hostname for auto-TLS
CADDY_EMAIL=admin@example.com   # Let's Encrypt notifications

# ── Web (Next.js / Vercel) ──────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
